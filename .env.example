# map.kiwimu.com 環境變數基準
#
# 這份檔案是「有哪些變數、各自幹什麼」的唯一稽核基準，**不放任何真實值**。
# 本機開發：複製成 .env.local 後填入實際值。
# production：值只存在 Vercel 專案設定（moon-map-original），不要寫回這裡。
#
# 標記說明
#   [前端] VITE_ 前綴＝會被打進 client bundle，任何人可讀 → 只能放公開值
#   [後端] 無前綴＝只在 Vercel serverless function 內可讀
#   [平台] 由 Vercel 自動注入，不需手動設定

# ── Supabase ────────────────────────────────────────────────
VITE_SUPABASE_URL=            # [前端] Supabase 專案 URL（公開值）
VITE_SUPABASE_ANON_KEY=       # [前端] anon key（公開值，受 RLS 保護）
SUPABASE_URL=                 # [後端] 同上專案 URL，供 api/ 使用
SUPABASE_SERVICE_ROLE_KEY=    # [後端] service role key ⚠️ 絕對不可加 VITE_ 前綴

# ── API 信任閘（見 api/_utils/verifyTrustedRequest.ts）──────────
ALLOWED_ORIGINS=              # [後端] 逗號分隔的額外允許 origin；production 建議明確設定，不要只靠內建 defaults
ALLOWED_PREVIEW_ORIGIN=       # [後端] 要放行的單一 Vercel preview origin（不支援 wildcard）
INTERNAL_API_TOKEN=           # [後端] server-to-server 呼叫用的共享 token；帶對了就直接過閘
                              #        ⚠️ 瀏覽器藏不住密鑰，所以前端呼叫不適用此通道

# ── Discord 訂單／活動通知 ──────────────────────────────────
DISCORD_TOKEN=                # [後端] bot token，用於發訂單通知
DISCORD_WEBHOOK_URL=          # [後端] 主訂單通知 webhook
DISCORD_WEBHOOK_ACTIVITY_URL= # [後端] 活動通知 webhook
DISCORD_WEBHOOK_VALENTINE_URL=# [後端] 節慶活動專用 webhook
DISCORD_NOTIFY_SIGNING_SECRET=      # [後端] HMAC 簽章密鑰（見 api/_utils/authorizeDiscordNotifyRequest.ts）
DISCORD_NOTIFY_REQUIRE_SIGNATURE=   # [後端] 'true' = 強制驗簽，無有效簽章即拒
                                    #        ⚠️ 目前 /api/notify-discord-order 是由瀏覽器呼叫（index.tsx），
                                    #           開了會直接打死訂單通知。要先把通知搬到 server 端
                                    #           才能啟用，詳見 docs/security/api-trust-gate-v2.md
DISCORD_NOTIFY_MAX_SIGNATURE_AGE_MS= # [後端] 簽章有效秒數（毫秒），預設 300000

# ── 跨站契約 ────────────────────────────────────────────────
SHOP_MENU_API_URL=            # [後端] shop 的 /api/menu/categories，map 的 /api/menu 代理來源

# ── 分析 ────────────────────────────────────────────────────
VITE_GA4_ID=                  # [前端] GA4 measurement ID（公開值）；index.html:213 有內建 fallback

# ── 僅離線腳本使用（不是 runtime 變數）──────────────────────
# SITE_KEY                    # scripts/generate-menu-display-config-seed.js，預設 'map'

# ── 平台自動注入（不需手動設定，列出僅供查閱）────────────────
# VERCEL_ENV                  # [平台] production | preview | development
# NODE_ENV                    # [平台] 建置／執行環境
